# ── Datos fuente del ERP (se descargan con AUTO_SSASUR.bat, no van al repo) ──
informe_completo_recetas*.csv
reporte_de_stock_*.xlsx
cantidad_de_productos_consumidos_en_centro_de_costo_farmacia*.xlsx
# reporte_listado_actividades: crudo de Agenda Médica, 1 fila por atención de
# paciente (trae RUT, Ley 19.628) — igual criterio que las 3 líneas de arriba.
# El agregado sin RUT vive en Servicios_Farmaceuticos/ (ver línea de abajo).
reporte_listado_actividades*.csv
reporte_listado_actividades*.xlsx

# ── GT crudo: su lugar es ../04_Farmacia_Gestion_Territorial/, no el repo.
# Red de seguridad por si algún download manual/con nombre mal formado queda
# suelto en la raíz del repo (trae RUT de pacientes — Ley 19.628; caso real
# detectado 30-07-2026, reporteGestionTerritorial<timestamp>.xlsx) ───────────
reporteGestionTerritorial*.xlsx

# ── Sesión SSASUR (contiene cookies/credenciales — NUNCA subir) ──────────────
.ssasur_session.json

# ── Estado de sync del árbol GT: sus claves son rutas de PDFs individuales
# con NOMBRES DE PACIENTES (Ley 19.628) — NUNCA subir a este repo público ────
_gt_arbol_sync.json

# ── Debug y temporales ────────────────────────────────────────────────────────
debug_*.png
_tmp_*.png
# descargar_recetas_pdf.py --debug vuelca capturas/HTML con nombre de paciente
# en el nombre de archivo (Ley 19.628) — NUNCA subir a este repo público.
debug_ssasur_receta/
~$*.xlsx
~$*.xls

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/

# ── Streamlit secretos (API keys locales) ────────────────────────────────────
.streamlit/secrets.toml

# Factor de empaque CENABAST (datos de intermediación)
cenabast_intermediacion.csv
ICP-Intermediacion*.csv

# ── Credenciales OAuth (Google Drive/Sheets) — NUNCA subir ────────────────────
credentials.json
token_drive.json
token_sheets.json

